# ============================================================
#  AfriCode — Fichier de configuration (.env)
#  Copiez ce fichier en .env et remplissez chaque valeur
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME=AfriCode
APP_ENV=production
APP_KEY=                        # Générer : php artisan key:generate
APP_DEBUG=false
APP_URL=https://africode.tech   # Votre domaine production (HTTPS obligatoire)

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logs ────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                 # 'debug' en dev, 'error' en prod

# ── Base de données MySQL ────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=votre_base_de_donnees
DB_USERNAME=votre_utilisateur
DB_PASSWORD=votre_mot_de_passe

# ── Session & Cache ──────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.africode.tech   # Avec le . pour couvrir les sous-domaines

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# ── Files d'attente (Queue) ──────────────────────────────────
QUEUE_CONNECTION=database       # 'redis' si Redis disponible chez Hostinger

# ── Email (SMTP) ─────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com        # Ou smtp.hostinger.com si email pro Hostinger
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=votre_email@africode.tech
MAIL_PASSWORD=votre_mot_de_passe_application
MAIL_FROM_ADDRESS="noreply@africode.tech"
MAIL_FROM_NAME="AfriCode"
MAIL_SUPPORT_EMAIL=support@africode.tech
ADMIN_EMAIL=support@africode.tech
CONTACT_EMAIL=contact@africode.tech

# ── Paiement — Moneroo ───────────────────────────────────────
MONEROO_KEY=                    # Votre clé publique Moneroo (pk_live_...)
MONEROO_SECRET_KEY=             # Votre clé secrète Moneroo (pvk_...) — NE JAMAIS PARTAGER
MONEROO_MODE=live               # 'sandbox' pour tests, 'live' pour production

# ── Paiement — Stripe (cartes bancaires) ─────────────────────
STRIPE_KEY=                     # Clé publique Stripe (pk_live_...)
STRIPE_SECRET=                  # Clé secrète Stripe (sk_live_...) — NE JAMAIS PARTAGER
STRIPE_WEBHOOK_SECRET=          # Secret webhook Stripe (whsec_...)

# ── Push Notifications VAPID ─────────────────────────────────
# Générer les clés : php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@africode.tech

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://africode.tech/auth/google/callback

# ── GitHub OAuth (optionnel) ─────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://africode.tech/auth/github/callback

# ── LinkedIn OAuth (optionnel) ───────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://africode.tech/auth/linkedin/callback

# ── Tracking & Pixels ────────────────────────────────────────
TRACKING_ENABLED=true
META_PIXEL_ENABLED=true
META_PIXEL_ID=9650375495040301
# GTM_ID=GTM-XXXXXXX
# GA4_ENABLED=true
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Vite ─────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── Services ─────────────────────────────────────────────────
SERVICES_MONEROO_KEY="${MONEROO_KEY}"
SERVICES_MONEROO_SECRET="${MONEROO_SECRET_KEY}"

# ── Ollama (IA locale) ───────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral

# =============================================================
# PRODUCTION (Hostinger VPS) — décommenter et configurer
# =============================================================

# Redis (recommandé pour 15k+ utilisateurs simultanés)
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis

# Sécurité session en production
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax   # 'strict' casse la vérification email + retours OAuth/paiement (liens cliqués depuis un autre site)
# SESSION_ENCRYPT=true
# SESSION_LIFETIME=120

# Production
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=error
